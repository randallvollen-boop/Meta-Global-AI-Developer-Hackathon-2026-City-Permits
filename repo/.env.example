# ACME City Permits: example settings.
#
# Copy this file OUTSIDE the repository (for example to ~/.config/ai-keys.env)
# and fill in META_API_KEY. Never commit a real key: `.env` is ignored by Git and
# scripts/scan_publishable_tree.py fails on secret-shaped values under repo/.
#
# Only META_API_KEY and ACME_SECRET_KEY are read from the key file (ACME_KEY_FILE,
# default ~/.config/ai-keys.env). Every other setting below is read from the
# environment only, so export it in the shell; copying this file into the key
# file does not apply the switches.
#
# The values shown are the application's defaults unless a comment says otherwise.

# Meta Model API key for live Muse (muse-spark-1.3 and muse-image-1.0).
# Leave empty to run with the replay fixtures only.
META_API_KEY=

# Session signing secret. Empty means a random secret for this process.
ACME_SECRET_KEY=

# Where the key file lives.
# ACME_KEY_FILE=~/.config/ai-keys.env

# Provider access. Unset means: on in demo mode, off in production mode.
# With a key present and this unset, local live calls are possible.
# ACME_MUSE_PROVIDER_ENABLED=1

# The extra lock of the hosted public demo (ACME_PUBLIC_DEMO=1). No effect locally.
ACME_MUSE_LIVE_CALLS_ALLOWED=0

# Live Muse per feature (off by default; a key alone never turns these on).
ACME_APPLICANT_ASSIST_LIVE_ENABLED=0
ACME_POLICY_ASSIST_LIVE_ENABLED=0
ACME_PRESUBMIT_REVIEW_LIVE_ENABLED=0

# Spend bounds. The live-call cap counts the completed live runs stored in the
# database, not calls per process. The hosted demo sets 100, 100 and 10.
ACME_MUSE_LIVE_CALL_CAP=2
ACME_MUSE_DAILY_CALL_CAP=10
ACME_MUSE_IMAGE_DAILY_CAP=10

# Text models the server may call; the image client is fixed to muse-image-1.0.
ACME_MUSE_MODEL_ALLOWLIST=muse-spark-1.3

# Deployment mode: demo (default) or production.
ACME_DEPLOYMENT_MODE=demo

# Database: a local SQLite file under repo/.
# ACME_DATABASE_URL=sqlite:///var/acme_city.db

# Clock shown in the demo: empty for the real clock, or a date such as 2026-10-14.
ACME_SCENARIO_CLOCK=
