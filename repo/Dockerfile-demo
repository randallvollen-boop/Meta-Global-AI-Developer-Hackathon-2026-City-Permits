# syntax=docker/dockerfile:1
#
# ACME City permits, demo image for hosts that always build the LAST stage and
# cannot pass `--target` (Render).  Same recipe as `Dockerfile` up to the
# `demo` stage; tests/security/test_public_demo_protection.py keeps the shared
# part identical.  Build context: this directory (repo/).
#
#   docker build -f Dockerfile-demo -t acme-permits:demo .

ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim AS base
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
# Dependencies first, so a code change reuses the installed packages.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev \
    && python -m compileall -q --invalidation-mode unchecked-hash src

FROM python:${PYTHON_VERSION}-slim AS runtime-base
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN useradd --system --uid 10001 --create-home --home-dir /home/acme --shell /usr/sbin/nologin acme \
    && mkdir -p /app/var && chown -R acme:acme /app
WORKDIR /app
COPY --from=base /opt/venv /opt/venv
COPY --from=base /app/src ./src
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
COPY config ./config
COPY docker/entrypoint.py /app/entrypoint.py
# Runtime data the service reads (rules text, GIS layers, document samples).
COPY fixtures ./fixtures
VOLUME ["/app/var"]
EXPOSE 8000
# The start period covers demo seeding (ACME_DEMO_SEED_ON_START) before the port opens.
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
    CMD ["python", "-c", "import os,sys,urllib.request as u; p=os.environ.get('PORT') or os.environ.get('ACME_BIND_PORT') or '8000'; sys.exit(0 if u.urlopen('http://127.0.0.1:'+p+'/readyz', timeout=4).status == 200 else 1)"]

# ----------------------------------------------------------------- demo
FROM runtime-base AS demo
COPY scripts ./scripts
# Seeding writes its walkthrough evidence here; data and uploads go to /app/var.
RUN mkdir -p /app/evidence && chown acme:acme /app/evidence
USER acme
ENV ACME_DEPLOYMENT_MODE=demo
ENTRYPOINT ["python", "/app/entrypoint.py"]
